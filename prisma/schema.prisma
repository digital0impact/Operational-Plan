// Prisma schema — منصة تخطيط لمدارس التعليم العام
// المرحلة الحالية: تسجيل المدرسة + تسجيل الدخول + معالج الخطة الكامل (25 خطوة)
// + معمار الخطط المتعددة (PlanType/PlanTemplate/PlanTemplateSection ثم
// Plan/PlanObjective/PlanProgram/PlanActivity/PlanIndicator/PlanEvidence):
// يشغّل أنواع خطط جديدة فعليًا (يبدأ بـ"خطة النشاط الطلابي")، بمعزل تام عن
// جداول الخطة التشغيلية القديمة أعلاه — معالج /wizard الحالي يواصل العمل
// على جداوله الخاصة دون أي تغيير. انظر تدقيق المعمار المنشور.
//
// الكيانات اللاحقة (خارج نطاق هذا الإصدار، انظر خطة المعمار المنشورة):
// PlanExport

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// مدرسة (Tenant) — تُنشأ عبر رمز تفعيل صادر من الإدارة العامة للتعليم
model School {
  id String @id @default(cuid())

  // بيانات المدرسة (النموذج الرسمي، صفحة 2)
  name                 String
  unit                 String // الوحدة (المرحلة)
  schoolSystem         String // نظام المدرسة
  ministryNumber       String? // الرقم الوزاري
  studyTime            String? // وقت الدراسة
  studentsCount        Int?
  classroomsCount      Int?
  gender               String // جنس المدرسة
  buildingType         String? // نوع المبنى
  educationType        String? // نوع التعليم
  buildingIndependence String? // استقلالية المبنى
  phone                String?
  schoolEmail          String?
  address              String?

  // مستوى الأداء (النموذج الرسمي، صفحة 2)
  performanceGeneral          String? // مستوى الأداء العام
  performanceManagement       String? // مستوى الإدارة المدرسية
  performanceTeachingLearning String? // مستوى التعليم والتعلم
  performanceLearningOutcomes String? // مستوى نواتج التعلم
  performanceEnvironment      String? // مستوى البيئة المدرسية

  // تتبع تقدم المعالج
  currentStep Int @default(1)

  // روابط عامة بلا تسجيل دخول
  voteToken  String @unique // رابط التصويت على المبادرات والبرامج
  shareToken String @unique // رابط المشاركة والتقييم

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activationCode   ActivationCode?
  users            User[]
  procedureInputs  ProcedureInput[]
  stepProgress     WizardStepProgress[]
  operationalGoals OperationalGoal[]
  swotItems        SwotItem[]
  keyIssues        KeyIssue[]
  evaluations      Evaluation[]
  classroomVisits  ClassroomVisit[]
  plans            Plan[]

  @@map("schools")
}

/// تتبّع إتمام كل خطوة من خطوات المعالج الخمس والعشرين
model WizardStepProgress {
  id          String   @id @default(cuid())
  step        Int
  completedAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, step])
  @@map("wizard_step_progress")
}

/// رمز تفعيل تصدره الإدارة العامة للتعليم لمدرسة واحدة (SCH-XXXX-XXXX)
model ActivationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  used      Boolean   @default(false)
  issuedFor String? // ملاحظة اختيارية: اسم المدرسة المستهدفة أو الإدارة
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  schoolId String? @unique
  school   School? @relation(fields: [schoolId], references: [id])

  @@map("activation_codes")
}

/// مستخدم (مدير مدرسة أو عضو فريق تميز)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SCHOOL_MANAGER") // SCHOOL_MANAGER | TEAM_MEMBER | GENERAL_ADMIN
  createdAt    DateTime @default(now())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  sessions Session[]

  @@map("users")
}

/// جلسة دخول (كوكي بالتوكن)
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// الأهداف الاستراتيجية العشرة — بيانات ثابتة تُزرع مرة واحدة (Seed)، لا تُعدَّل من المدرسة
model StrategicGoal {
  id    String @id @default(cuid())
  order Int    @unique
  title String

  operationalGoals OperationalGoal[]

  @@map("strategic_goals")
}

/// الهدف التشغيلي للمدرسة — واحد لكل هدف استراتيجي (مصفوفة النموذج الرسمي، صفحة 3)
model OperationalGoal {
  id   String @id @default(cuid())
  text String @default("")

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  strategicGoalId String
  strategicGoal   StrategicGoal @relation(fields: [strategicGoalId], references: [id])

  kpi         KPI?
  initiatives InitiativeProgram[]

  @@unique([schoolId, strategicGoalId])
  @@map("operational_goals")
}

/// مؤشر قياس الأداء + القيمة المستهدفة لكل هدف تشغيلي (النموذج الرسمي، صفحة 4)
model KPI {
  id          String @id @default(cuid())
  indicator   String @default("")
  targetValue String @default("")

  operationalGoalId String          @unique
  operationalGoal   OperationalGoal @relation(fields: [operationalGoalId], references: [id], onDelete: Cascade)

  @@map("kpis")
}

/// بند من بنود تحليل SWOT (النموذج الرسمي، صفحة 4)
model SwotItem {
  id       String @id @default(cuid())
  category String // STRENGTH | WEAKNESS | OPPORTUNITY | THREAT
  text     String
  order    Int    @default(0)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("swot_items")
}

/// قضية رئيسية (النموذج الرسمي، صفحة 5)
model KeyIssue {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("key_issues")
}

/// مبادرة أو برنامج تحت هدف تشغيلي (النموذج الرسمي، صفحة 5)
model InitiativeProgram {
  id    String @id @default(cuid())
  type  String // INITIATIVE | PROGRAM
  name  String
  order Int    @default(0)

  operationalGoalId String
  operationalGoal   OperationalGoal @relation(fields: [operationalGoalId], references: [id], onDelete: Cascade)

  actionItems ActionItem[]
  votes       Vote[]

  @@map("initiatives_programs")
}

/// صوت واحد على مبادرة أو برنامج — عبر رابط عام بلا تسجيل دخول
model Vote {
  id        String   @id @default(cuid())
  voterName String? // اسم المصوّت (اختياري)
  createdAt DateTime @default(now())

  initiativeId String
  initiative   InitiativeProgram @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@map("votes")
}

/// تقييم مُرسَل عبر رابط المشاركة العام (مشرف تربوي / ولي أمر)
model Evaluation {
  id           String   @id @default(cuid())
  reviewerName String
  reviewerRole String // SUPERVISOR | PARENT | OTHER
  rating       Int // 1-5
  comment      String?
  createdAt    DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("evaluations")
}

/// سطر تنفيذ في الجدول التفصيلي لكل هدف استراتيجي (النموذج الرسمي، صفحات 6-9)
model ActionItem {
  id                    String  @id @default(cuid())
  activity              String  @default("") // الأنشطة
  targetCategory        String  @default("") // الفئة المستهدفة
  executionRequirements String  @default("") // متطلبات التنفيذ
  executionDate         String  @default("") // تاريخ التنفيذ
  responsible           String  @default("") // التنفيذ والمسؤولية
  evidence              String  @default("") // الشواهد (نص)
  evidenceImageData     Bytes? // صورة الشاهد (صورة عادية أو صورة باركود/QR) — مُخزَّنة كبيانات ثنائية
  evidenceImageType     String? // نوع MIME لصورة الشاهد، مثل image/png
  order                 Int     @default(0)

  initiativeId String
  initiative   InitiativeProgram @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, order])
  @@map("action_items")
}

/// مدخلات الإجراء — قائمة ثابتة من 4 عناصر لكل مدرسة (النموذج الرسمي، صفحة 2)
model ProcedureInput {
  id           String   @id @default(cuid())
  type         String // PERFORMANCE_REPORT | MINISTRY_STRATEGY | ADMIN_PLAN | CORRECTIVE_ACTIONS
  acknowledged Boolean  @default(false)
  note         String?
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, type])
  @@map("procedure_inputs")
}

/// زيارة صفية تُجدولها المدرسة لمعلم/ة — يُرسَل رابط رد عام (بلا تسجيل
/// دخول) للمعلم/ة ليؤكّد الزيارة أو يطلب إعادة جدولتها
model ClassroomVisit {
  id            String    @id @default(cuid())
  teacherName   String // اسم المعلم/ة
  subject       String? // المادة
  className     String? // الصف/الشعبة
  scheduledAt   DateTime // التاريخ والوقت المقترح للزيارة
  purpose       String? // الغرض من الزيارة / ملاحظات المدرسة
  status        String    @default("SCHEDULED") // SCHEDULED | CONFIRMED | RESCHEDULE_REQUESTED
  responseToken String    @unique // رابط رد المعلم/ة العام
  responseNote  String? // ملاحظة المعلم/ة عند الرد (خصوصًا عند طلب إعادة الجدولة)
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("classroom_visits")
}

// ─────────────────────────────────────────────────────────────────────────
// أساس منصة الخطط المتعددة (مرحلة أ من خطة المعمار)
//
// الجداول الثلاثة التالية إضافية بالكامل: لا تُعدِّل أي جدول قائم أعلاه،
// ولا يقرأها أي مسار أو Server Action حالي. الهدف هو جعل "نوع الخطة" و
// "أقسامها" بيانات تُدار من لوحة الإدارة بدل ثوابت TypeScript، تمهيدًا
// لتشغيل أنواع خطط جديدة (نشاط طلابي، إرشاد، إذاعة...) على معمار عام لاحقًا
// — دون المساس بمعالج الخطة التشغيلية الحالي.
// ─────────────────────────────────────────────────────────────────────────

/// نوع خطة مدرسية (تشغيلية، نشاط طلابي، إرشاد طلابي، إذاعة مدرسية...)
model PlanType {
  id        String   @id @default(cuid())
  key       String   @unique // معرّف ثابت بالإنجليزية، مثل operational
  nameAr    String
  nameEn    String
  isCustom  Boolean  @default(false) // نوع خطة أنشأته مدرسة بنفسها لا الإدارة العامة
  createdAt DateTime @default(now())

  templates PlanTemplate[]

  @@map("plan_types")
}

/// قالب (نسخة) من نوع خطة — يسمح بتحديث دليل الإجراء لعام جديد دون كسر
/// الخطط القائمة المرتبطة بالنسخة السابقة
model PlanTemplate {
  id        String   @id @default(cuid())
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  planTypeId String
  planType   PlanType @relation(fields: [planTypeId], references: [id], onDelete: Cascade)

  sections PlanTemplateSection[]
  plans    Plan[]

  @@unique([planTypeId, version])
  @@map("plan_templates")
}

/// قسم ضمن قالب خطة — kind من مجموعة مغلقة يعرفها الكود (انظر تدقيق
/// المعمار، المرحلة 7)، وconfigJson يحمل ضبط القسم (تسميات الحقول، حد
/// التكرار، تفعيل اقتراح الذكاء الاصطناعي...) دون الحاجة لتعديل الكود
model PlanTemplateSection {
  id         String  @id @default(cuid())
  key        String // معرّف القسم داخل القالب، مثل swot أو detail_table
  order      Int     @default(0)
  titleAr    String
  titleEn    String?
  kind       String // STATIC_INFO | ACKNOWLEDGEMENT_LIST | REFERENCE_LIST | OBJECTIVES_LIST | INDICATORS_LIST | SWOT_GRID | REPEATABLE_TEXT_LIST | PROGRAMS_LIST | DETAIL_TABLE | WEEKLY_ACTIVITY_GRID | PROGRAM_WEEK_TAGS | COMBINED_CALENDAR
  configJson Json?

  templateId String
  template   PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@map("plan_template_sections")
}

// ─────────────────────────────────────────────────────────────────────────
// معمار الخطط العام (مرحلة ب من خطة المعمار)
//
// الجداول التالية هي التسلسل الفعلي الذي اقترحه تدقيق المعمار:
// Plan → PlanObjective → PlanProgram → PlanActivity → PlanIndicator/PlanEvidence
// إضافية بالكامل، ولا تمسّ أي جدول من جداول الخطة التشغيلية القديمة أعلاه —
// معالج /wizard الحالي يواصل العمل على جداوله الخاصة دون أي تغيير. تخدم هذه
// الجداول فقط أنواع الخطط الجديدة (يبدأ التشغيل الفعلي بـ"خطة النشاط
// الطلابي" كأول تجربة حقيقية على هذا المعمار العام).
// ─────────────────────────────────────────────────────────────────────────

/// خطة فعلية لمدرسة — مدرسة × قالب × سنة دراسية
model Plan {
  id           String   @id @default(cuid())
  academicYear String // مثل "1447-1448هـ"
  status       String   @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETE
  voteToken    String?  @unique
  shareToken   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  templateId String
  template   PlanTemplate @relation(fields: [templateId], references: [id])

  sectionProgress PlanSectionProgress[]
  objectives      PlanObjective[]
  gridRows        PlanGridRow[]
  gridWeeks       PlanGridWeek[]

  @@unique([schoolId, templateId, academicYear])
  @@map("plans")
}

/// تتبّع إتمام قسم من أقسام قالب الخطة — يعمّم WizardStepProgress
model PlanSectionProgress {
  id          String   @id @default(cuid())
  sectionKey  String
  completedAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sectionKey])
  @@map("plan_section_progress")
}

/// عنصر ضمن قسم من نوع قائمة (هدف، قضية رئيسية...) — sectionKey يُميّز
/// إلى أي قسم من أقسام القالب ينتمي هذا الصف (خطة واحدة قد تملك أكثر من
/// قسم من هذا النوع، مثل "الأهداف" و"القضايا الرئيسية" معًا)
model PlanObjective {
  id    String @id @default(cuid())
  text  String @default("")
  order Int    @default(0)

  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  sectionKey String

  indicators PlanIndicator[]
  programs   PlanProgram[]
  evidence   PlanEvidence[]

  @@map("plan_objectives")
}

/// مؤشر قياس أداء + قيمة مستهدفة + قيمة فعلية لهدف — يضيف عمود القيمة
/// الفعلية غير الموجود في KPI القديم، لتتبّع التقدّم الفعلي لا الإدخال فقط
model PlanIndicator {
  id          String @id @default(cuid())
  indicator   String @default("")
  targetValue String @default("")
  actualValue String @default("")
  order       Int    @default(0)

  objectiveId String
  objective   PlanObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, order])
  @@map("plan_indicators")
}

/// مبادرة/برنامج تحت هدف — type نص حر يحدده القالب، وليس enum مقفلًا على
/// قيمتين كما في InitiativeProgram القديم
model PlanProgram {
  id    String @id @default(cuid())
  type  String @default("")
  name  String
  order Int    @default(0)

  objectiveId String
  objective   PlanObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  activities PlanActivity[]
  weekTags   PlanProgramWeekTag[]

  @@map("plan_programs")
}

/// نشاط تنفيذي تحت برنامج/مبادرة
model PlanActivity {
  id                    String @id @default(cuid())
  activity              String @default("")
  targetCategory        String @default("")
  executionRequirements String @default("")
  executionDate         String @default("")
  responsible           String @default("")
  status                String @default("PLANNED") // PLANNED | IN_PROGRESS | DONE
  order                 Int    @default(0)

  // حقول أضافها دليل إجراءات عمل مدارس التعليم العام — الإصدار الرابع
  // (رجب 1446هـ/يناير 2025م) صراحةً لخطة النشاط الطالبي (إجراء تنفيذ
  // برامج النشاط الطالبي)، وتعمّم على أي قسم DETAIL_TABLE في أي نوع خطة
  supervisor                     String @default("") // المشرف — يُختار وفق التخصص والخبرات والمهارات
  estimatedBudget                String @default("") // الميزانية التقديرية للنشاط
  regulatorySecurityRequirements String @default("") // الاشتراطات النظامية والأمنية
  planningNote                   String @default("") // ملاحظة تخطيط — موافقة إدارة التعليم لبرنامج خارج الخطة، أو ارتباطه بمناسبة محلية/دولية

  programId String
  program   PlanProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  evidence PlanEvidence[]

  @@unique([programId, order])
  @@map("plan_activities")
}

/// شاهد — عنصر مستقل قد يتعدّد لكل نشاط/هدف (خلافًا لخانة الشاهد الواحدة
/// في ActionItem القديم). fileData/fileType جاهزان لدعم رفع صورة لاحقًا؛
/// النص فقط مُنفَّذ في واجهة المرحلة ب الحالية
model PlanEvidence {
  id        String   @id @default(cuid())
  kind      String   @default("TEXT") // TEXT | IMAGE | LINK
  textValue String?
  fileData  Bytes?
  fileType  String?
  url       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  activityId String?
  activity   PlanActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  objectiveId String?
  objective   PlanObjective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@map("plan_evidence")
}

// ─────────────────────────────────────────────────────────────────────────
// قسم WEEKLY_ACTIVITY_GRID — جدول أسبوعي (صف/فئة × أسبوع)، مثل جدول خطة
// النشاط الطلابي الفعلي الذي تنتجه المدارس (نموذج ورقي/Excel واقعي رصدناه
// من مدرسة فعلية). خلافًا لبقية أقسام المعمار العام، عدد "الصفوف" هنا حرّ
// يحدده مدير المدرسة (فئات مختلفة حسب طبيعة كل مدرسة)، بينما عدد "الأسابيع"
// ثابت يحدده configJson لقسم القالب (افتراضيًا 18، فصل دراسي كامل تقريبًا).
// ─────────────────────────────────────────────────────────────────────────

/// صف مخصص (صف دراسي أو فئة أخرى يحددها مدير المدرسة) ضمن جدول أسبوعي
model PlanGridRow {
  id    String @id @default(cuid())
  label String @default("")
  order Int    @default(0)

  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  sectionKey String

  cells PlanGridCell[]

  @@unique([planId, sectionKey, order])
  @@map("plan_grid_rows")
}

/// عمود أسبوع ضمن جدول أسبوعي — عدده ثابت (configJson.weeksCount)، وتسميته
/// (نطاق التاريخ الهجري/الميلادي) حرة يكتبها مدير المدرسة
model PlanGridWeek {
  id    String @id @default(cuid())
  label String @default("")
  order Int // 1..weeksCount

  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  sectionKey String

  @@unique([planId, sectionKey, order])
  @@map("plan_grid_weeks")
}

/// محتوى خلية تقاطع صف × أسبوع — نص حر واحد (قد يجمع المجال والبرنامج
/// واسم المسؤولة في نفس الخلية بأسطر متعددة، كما يكتبه مدير المدرسة فعليًا)
model PlanGridCell {
  id      String @id @default(cuid())
  content String @default("")

  rowId     String
  row       PlanGridRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  weekOrder Int

  @@unique([rowId, weekOrder])
  @@map("plan_grid_cells")
}

/// وسم برنامج بأسبوع من أسابيع "الخطة الفصلية" (COMBINED_CALENDAR) — قسم
/// PROGRAM_WEEK_TAGS في كل من خطط التوجيه الطلابي/النشاط الطلابي/الإرشاد
/// الصحي يديره. علاقة عديد-إلى-عديد بسيطة (برنامج واحد قد يتكرر في أكثر
/// من أسبوع، مثل برنامج تعزيز السلوك الإيجابي المستمر أسبوعيًا)، بلا جدول
/// وسيط لاسم الأسبوع — القيمة رقم الأسبوع فقط، تُقرأ عبر PlanGridWeek
/// الخاصة بخطة "الخطة الفصلية" نفسها عند العرض/التصدير.
model PlanProgramWeekTag {
  id        String @id @default(cuid())
  weekOrder Int

  programId String
  program   PlanProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, weekOrder])
  @@map("plan_program_week_tags")
}
