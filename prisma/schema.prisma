// Prisma schema — منصة الخطة التشغيلية لمدارس التعليم العام
// المرحلة الحالية: تسجيل المدرسة + تسجيل الدخول + معالج الخطة الكامل (25 خطوة)
//
// الكيانات اللاحقة (خارج نطاق هذا الإصدار، انظر خطة المعمار المنشورة):
// PlanExport

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// أنواع الخطط المدرسية التي تدعمها المنصة تدريجيًا.
enum PlanTypeKey {
  SCHOOL_OPERATIONAL
  STUDENT_ACTIVITIES
  COUNSELING
  SCHOOL_BROADCAST
  HEALTH
  SAFETY
  PROFESSIONAL_DEVELOPMENT
  GIFTED
  LEARNING_SUPPORT
}

/// حالة الخطة المدرسية على مستوى طبقة التوافق الجديدة.
enum PlanStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

/// نوع خطة مدرسية — تُزرع الأنواع النظامية تدريجيًا حسب مراحل المنتج.
model PlanType {
  id          String      @id @default(cuid())
  key         PlanTypeKey @unique
  nameAr      String
  nameEn      String
  description String?
  isSystem    Boolean     @default(true)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  plans     Plan[]
  templates PlanTemplate[]

  @@map("plan_types")
}

/// قالب خطة مدرسية — في هذه المرحلة هو بيانات وصفية لقالب المعالج التشغيلي الحالي فقط.
model PlanTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  version     String
  nameAr      String
  nameEn      String
  description String?
  schemaJson  Json
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planTypeId String
  planType   PlanType @relation(fields: [planTypeId], references: [id], onDelete: Restrict)

  plans Plan[]

  @@unique([planTypeId, key])
  @@map("plan_templates")
}

/// خطة مدرسية — طبقة توافق مستقلة فوق بيانات الخطة التشغيلية الحالية دون نقلها.
model Plan {
  id              String     @id @default(cuid())
  academicYear    String
  title           String
  status          PlanStatus @default(DRAFT)
  currentStep     Int        @default(1)
  progressPercent Int        @default(0)
  shareToken      String?    @unique
  voteToken       String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?

  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planTypeId String
  planType   PlanType     @relation(fields: [planTypeId], references: [id], onDelete: Restrict)
  templateId String
  template   PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  stepProgress PlanStepProgress[]

  @@unique([schoolId, planTypeId])
  @@map("plans")
}

/// تتبع إتمام خطوات الخطة على مستوى طبقة الخطط الجديدة.
model PlanStepProgress {
  id          String   @id @default(cuid())
  step        Int
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  completedByUserId String?
  completedByUser   User?   @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([planId, step])
  @@map("plan_step_progress")
}

/// مدرسة (Tenant) — تُنشأ عبر رمز تفعيل صادر من الإدارة العامة للتعليم
model School {
  id String @id @default(cuid())

  // بيانات المدرسة (النموذج الرسمي، صفحة 2)
  name                 String
  unit                 String // الوحدة (المرحلة)
  schoolSystem         String // نظام المدرسة
  ministryNumber       String? // الرقم الوزاري
  studyTime            String? // وقت الدراسة
  studentsCount        Int?
  classroomsCount      Int?
  gender               String // جنس المدرسة
  buildingType         String? // نوع المبنى
  educationType        String? // نوع التعليم
  buildingIndependence String? // استقلالية المبنى
  phone                String?
  schoolEmail          String?
  address              String?

  // مستوى الأداء (النموذج الرسمي، صفحة 2)
  performanceGeneral          String? // مستوى الأداء العام
  performanceManagement       String? // مستوى الإدارة المدرسية
  performanceTeachingLearning String? // مستوى التعليم والتعلم
  performanceLearningOutcomes String? // مستوى نواتج التعلم
  performanceEnvironment      String? // مستوى البيئة المدرسية

  // تتبع تقدم المعالج
  currentStep Int @default(1)

  // روابط عامة بلا تسجيل دخول
  voteToken  String @unique // رابط التصويت على المبادرات والبرامج
  shareToken String @unique // رابط المشاركة والتقييم

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activationCode   ActivationCode?
  users            User[]
  procedureInputs  ProcedureInput[]
  stepProgress     WizardStepProgress[]
  operationalGoals OperationalGoal[]
  swotItems        SwotItem[]
  keyIssues        KeyIssue[]
  evaluations      Evaluation[]
  classroomVisits  ClassroomVisit[]
  plans            Plan[]

  @@map("schools")
}

/// تتبّع إتمام كل خطوة من خطوات المعالج الخمس والعشرين
model WizardStepProgress {
  id          String   @id @default(cuid())
  step        Int
  completedAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, step])
  @@map("wizard_step_progress")
}

/// رمز تفعيل تصدره الإدارة العامة للتعليم لمدرسة واحدة (SCH-XXXX-XXXX)
model ActivationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  used      Boolean   @default(false)
  issuedFor String? // ملاحظة اختيارية: اسم المدرسة المستهدفة أو الإدارة
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  schoolId String? @unique
  school   School? @relation(fields: [schoolId], references: [id])

  @@map("activation_codes")
}

/// مستخدم (مدير مدرسة أو عضو فريق تميز)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SCHOOL_MANAGER") // SCHOOL_MANAGER | TEAM_MEMBER | GENERAL_ADMIN
  createdAt    DateTime @default(now())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  sessions          Session[]
  planStepProgress PlanStepProgress[]

  @@map("users")
}

/// جلسة دخول (كوكي بالتوكن)
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// الأهداف الاستراتيجية العشرة — بيانات ثابتة تُزرع مرة واحدة (Seed)، لا تُعدَّل من المدرسة
model StrategicGoal {
  id    String @id @default(cuid())
  order Int    @unique
  title String

  operationalGoals OperationalGoal[]

  @@map("strategic_goals")
}

/// الهدف التشغيلي للمدرسة — واحد لكل هدف استراتيجي (مصفوفة النموذج الرسمي، صفحة 3)
model OperationalGoal {
  id   String @id @default(cuid())
  text String @default("")

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  strategicGoalId String
  strategicGoal   StrategicGoal @relation(fields: [strategicGoalId], references: [id])

  kpi         KPI?
  initiatives InitiativeProgram[]

  @@unique([schoolId, strategicGoalId])
  @@map("operational_goals")
}

/// مؤشر قياس الأداء + القيمة المستهدفة لكل هدف تشغيلي (النموذج الرسمي، صفحة 4)
model KPI {
  id          String @id @default(cuid())
  indicator   String @default("")
  targetValue String @default("")

  operationalGoalId String          @unique
  operationalGoal   OperationalGoal @relation(fields: [operationalGoalId], references: [id], onDelete: Cascade)

  @@map("kpis")
}

/// بند من بنود تحليل SWOT (النموذج الرسمي، صفحة 4)
model SwotItem {
  id       String @id @default(cuid())
  category String // STRENGTH | WEAKNESS | OPPORTUNITY | THREAT
  text     String
  order    Int    @default(0)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("swot_items")
}

/// قضية رئيسية (النموذج الرسمي، صفحة 5)
model KeyIssue {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("key_issues")
}

/// مبادرة أو برنامج تحت هدف تشغيلي (النموذج الرسمي، صفحة 5)
model InitiativeProgram {
  id    String @id @default(cuid())
  type  String // INITIATIVE | PROGRAM
  name  String
  order Int    @default(0)

  operationalGoalId String
  operationalGoal   OperationalGoal @relation(fields: [operationalGoalId], references: [id], onDelete: Cascade)

  actionItems ActionItem[]
  votes       Vote[]

  @@map("initiatives_programs")
}

/// صوت واحد على مبادرة أو برنامج — عبر رابط عام بلا تسجيل دخول
model Vote {
  id        String   @id @default(cuid())
  voterName String? // اسم المصوّت (اختياري)
  createdAt DateTime @default(now())

  initiativeId String
  initiative   InitiativeProgram @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@map("votes")
}

/// تقييم مُرسَل عبر رابط المشاركة العام (مشرف تربوي / ولي أمر)
model Evaluation {
  id           String   @id @default(cuid())
  reviewerName String
  reviewerRole String // SUPERVISOR | PARENT | OTHER
  rating       Int // 1-5
  comment      String?
  createdAt    DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("evaluations")
}

/// سطر تنفيذ في الجدول التفصيلي لكل هدف استراتيجي (النموذج الرسمي، صفحات 6-9)
model ActionItem {
  id                    String  @id @default(cuid())
  activity              String  @default("") // الأنشطة
  targetCategory        String  @default("") // الفئة المستهدفة
  executionRequirements String  @default("") // متطلبات التنفيذ
  executionDate         String  @default("") // تاريخ التنفيذ
  responsible           String  @default("") // التنفيذ والمسؤولية
  evidence              String  @default("") // الشواهد (نص)
  evidenceImageData     Bytes? // صورة الشاهد (صورة عادية أو صورة باركود/QR) — مُخزَّنة كبيانات ثنائية
  evidenceImageType     String? // نوع MIME لصورة الشاهد، مثل image/png
  order                 Int     @default(0)

  initiativeId String
  initiative   InitiativeProgram @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, order])
  @@map("action_items")
}

/// مدخلات الإجراء — قائمة ثابتة من 4 عناصر لكل مدرسة (النموذج الرسمي، صفحة 2)
model ProcedureInput {
  id           String   @id @default(cuid())
  type         String // PERFORMANCE_REPORT | MINISTRY_STRATEGY | ADMIN_PLAN | CORRECTIVE_ACTIONS
  acknowledged Boolean  @default(false)
  note         String?
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, type])
  @@map("procedure_inputs")
}

/// زيارة صفية تُجدولها المدرسة لمعلم/ة — يُرسَل رابط رد عام (بلا تسجيل
/// دخول) للمعلم/ة ليؤكّد الزيارة أو يطلب إعادة جدولتها
model ClassroomVisit {
  id            String    @id @default(cuid())
  teacherName   String // اسم المعلم/ة
  subject       String? // المادة
  className     String? // الصف/الشعبة
  scheduledAt   DateTime // التاريخ والوقت المقترح للزيارة
  purpose       String? // الغرض من الزيارة / ملاحظات المدرسة
  status        String    @default("SCHEDULED") // SCHEDULED | CONFIRMED | RESCHEDULE_REQUESTED
  responseToken String    @unique // رابط رد المعلم/ة العام
  responseNote  String? // ملاحظة المعلم/ة عند الرد (خصوصًا عند طلب إعادة الجدولة)
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("classroom_visits")
}
